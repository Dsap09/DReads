---
interface Props {
  initialQuery?: string;
  initialSource?: string;
}

const { initialQuery = '', initialSource = 'all' } = Astro.props;
---

<div class="sticky top-0 z-30 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80 px-4 py-2.5">
  <form id="search-form" action="/search" method="GET" class="flex flex-col gap-2">
    <!-- Input Bar -->
    <div class="relative flex items-center">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>

      <input
        type="search"
        name="q"
        id="search-input"
        value={initialQuery}
        placeholder="Cari judul buku atau penulis..."
        required
        autocomplete="off"
        class="w-full pl-10 pr-10 py-2.5 bg-slate-900 border border-slate-800 rounded-full text-slate-100 text-sm placeholder-slate-400 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-colors"
      />

      <input type="hidden" name="source" id="source-input" value={initialSource} />

      <button
        type="button"
        id="clear-btn"
        class={`absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-200 ${initialQuery ? '' : 'hidden'}`}
        aria-label="Bersihkan pencarian"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Source Chips -->
    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 text-xs">
      <button
        type="button"
        data-source="all"
        class={`source-chip px-3 py-1 rounded-full whitespace-nowrap transition-colors touch-target min-h-[32px] ${initialSource === 'all' ? 'bg-amber-500 text-slate-950 font-semibold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'}`}
      >
        Semua Sumber
      </button>

      <button
        type="button"
        data-source="gutendex"
        class={`source-chip px-3 py-1 rounded-full whitespace-nowrap transition-colors touch-target min-h-[32px] ${initialSource === 'gutendex' ? 'bg-amber-500 text-slate-950 font-semibold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'}`}
      >
        Gutendex (Baca Gratis)
      </button>
      <button
        type="button"
        data-source="openlibrary"
        class={`source-chip px-3 py-1 rounded-full whitespace-nowrap transition-colors touch-target min-h-[32px] ${initialSource === 'openlibrary' ? 'bg-amber-500 text-slate-950 font-semibold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'}`}
      >
        Open Library
      </button>
      <button
        type="button"
        data-source="googlebooks"
        class={`source-chip px-3 py-1 rounded-full whitespace-nowrap transition-colors touch-target min-h-[32px] ${initialSource === 'googlebooks' ? 'bg-amber-500 text-slate-950 font-semibold' : 'bg-slate-900 text-slate-400 hover:text-slate-200'}`}
      >
        Google Books
      </button>
    </div>
  </form>
</div>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-btn');
  const sourceInput = document.getElementById('source-input') as HTMLInputElement;
  const form = document.getElementById('search-form') as HTMLFormElement;
  const chips = document.querySelectorAll('.source-chip');

  if (searchInput && clearBtn) {
    searchInput.addEventListener('input', () => {
      if (searchInput.value.trim().length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
    });

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      clearBtn.classList.add('hidden');
      searchInput.focus();
    });
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const selectedSource = chip.getAttribute('data-source') || 'all';
      if (sourceInput) {
        sourceInput.value = selectedSource;
      }
      chips.forEach(c => {
        c.className = `source-chip px-3 py-1 rounded-full whitespace-nowrap transition-colors touch-target min-h-[32px] ${
          c.getAttribute('data-source') === selectedSource
            ? 'bg-amber-500 text-slate-950 font-semibold'
            : 'bg-slate-900 text-slate-400 hover:text-slate-200'
        }`;
      });
      if (searchInput && searchInput.value.trim().length > 0) {
        form.submit();
      }
    });
  });
</script>
