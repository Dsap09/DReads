---
interface Props {
  activeTab?: 'home' | 'search' | 'library' | 'read';
}

const { activeTab = 'home' } = Astro.props;
---

<nav class="fixed bottom-0 left-0 right-0 z-40 bg-slate-900/95 backdrop-blur-md border-t border-slate-800 shadow-lg pb-[env(safe-area-inset-bottom)]">
  <div class="max-w-md mx-auto flex items-center justify-around h-16 px-2">
    <!-- Home Tab -->
    <a 
      href="/" 
      class={`flex flex-col items-center justify-center flex-1 h-full touch-target transition-colors ${activeTab === 'home' ? 'text-amber-500 font-medium' : 'text-slate-400 hover:text-slate-200'}`}
      aria-label="Beranda"
    >
      <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span class="text-xs">Beranda</span>
    </a>

    <!-- Search Tab -->
    <a 
      href="/search" 
      class={`flex flex-col items-center justify-center flex-1 h-full touch-target transition-colors ${activeTab === 'search' ? 'text-amber-500 font-medium' : 'text-slate-400 hover:text-slate-200'}`}
      aria-label="Cari Buku"
    >
      <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <span class="text-xs">Cari</span>
    </a>

    <!-- Library Tab -->
    <a 
      href="/library" 
      class={`flex flex-col items-center justify-center flex-1 h-full touch-target transition-colors ${activeTab === 'library' ? 'text-amber-500 font-medium' : 'text-slate-400 hover:text-slate-200'}`}
      aria-label="Koleksi Saya"
    >
      <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
      </svg>
      <span class="text-xs">Koleksi</span>
    </a>
  </div>
</nav>
