---
interface Props {
  count?: number;
}

const { count = 4 } = Astro.props;
const items = Array.from({ length: count });
---

<div class="flex flex-col gap-3 w-full">
  {items.map(() => (
    <div class="flex items-center gap-3 p-3 bg-slate-900/40 border border-slate-800/50 rounded-xl animate-pulse">
      <!-- Thumbnail skeleton -->
      <div class="w-16 h-22 bg-slate-800 rounded-lg flex-shrink-0"></div>
      
      <!-- Text skeleton -->
      <div class="flex-1 space-y-2 py-1">
        <div class="h-4 bg-slate-800 rounded w-3/4"></div>
        <div class="h-3 bg-slate-800/60 rounded w-1/2"></div>
        <div class="flex gap-2 pt-1">
          <div class="h-3 bg-slate-800/40 rounded w-16"></div>
          <div class="h-3 bg-slate-800/40 rounded w-10"></div>
        </div>
      </div>
    </div>
  ))}
</div>
