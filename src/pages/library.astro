---
import MobileLayout from '../layouts/MobileLayout.astro';
---

<MobileLayout title="Koleksi Saya - DReads" activeTab="library">
  <!-- Header -->
  <div class="px-4 pt-5 pb-3 bg-slate-950 border-b border-slate-800">
    <h1 class="text-lg font-bold text-slate-100">Koleksi Saya</h1>
    <p class="text-xs text-slate-400">Daftar buku dan penanda halaman yang Anda simpan di perangkat ini</p>
  </div>

  <!-- Content Container -->
  <div class="px-4 py-4 space-y-4">
    <!-- Filter Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-800 pb-3 text-xs">
      <button id="filter-all" class="px-3 py-1.5 rounded-full bg-amber-500 text-slate-950 font-semibold touch-target min-h-[36px]">
        Semua (<span id="count-all">0</span>)
      </button>
      <button id="filter-reading" class="px-3 py-1.5 rounded-full bg-slate-900 text-slate-400 hover:text-slate-200 touch-target min-h-[36px]">
        Sedang Dibaca (<span id="count-reading">0</span>)
      </button>
    </div>

    <!-- Saved Books Container (Hydrated Client Side) -->
    <div id="library-list" class="space-y-3">
      <!-- Skeleton placeholder while client loads -->
      <div class="p-8 text-center text-slate-500 text-xs">Memuat koleksi buku Anda...</div>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden p-8 text-center space-y-4 bg-slate-900/40 rounded-2xl border border-slate-800/60 my-6">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-800 flex items-center justify-center text-amber-500">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
        </svg>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-slate-200">Belum ada buku di simpan</h2>
        <p class="text-xs text-slate-400 max-w-xs mx-auto mt-1">
          Saat mencari atau membaca buku, tekan ikon penanda (bookmark) untuk menyimpannya ke halaman ini.
        </p>
      </div>
      <a href="/search" class="inline-block px-4 py-2 bg-amber-500 text-slate-950 font-semibold text-xs rounded-xl shadow">
        Cari Buku Sekarang
      </a>
    </div>
  </div>

  <script>
    import { getSavedBooks, removeBook, type SavedBook } from '../lib/storage';

    let currentFilter = 'all';

    function renderLibrary() {
      const books = getSavedBooks();
      const listContainer = document.getElementById('library-list');
      const emptyState = document.getElementById('empty-state');
      const countAll = document.getElementById('count-all');
      const countReading = document.getElementById('count-reading');

      if (!listContainer || !emptyState) return;

      const readingCount = books.filter(b => (b.lastReadProgress || 0) > 0).length;
      if (countAll) countAll.textContent = String(books.length);
      if (countReading) countReading.textContent = String(readingCount);

      const filteredBooks = books.filter(b => {
        if (currentFilter === 'reading') return (b.lastReadProgress || 0) > 0;
        return true;
      });

      if (filteredBooks.length === 0) {
        listContainer.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      listContainer.innerHTML = filteredBooks.map((book: SavedBook) => {
        const isGutenberg = book.source === 'gutendex';
        const gutenId = isGutenberg ? book.id.replace('gutenberg:', '') : null;
        const targetHref = isGutenberg ? `/read/${gutenId}` : `/book/${encodeURIComponent(book.id)}`;
        const progress = book.lastReadProgress || 0;

        return `
          <div class="flex items-center gap-3 p-3 bg-slate-900/60 border border-slate-800 rounded-xl">
            <a href="${targetHref}" class="flex-shrink-0 w-16 h-22 rounded-lg overflow-hidden bg-slate-800 border border-slate-700/50">
              ${book.coverSmallUrl || book.coverUrl ? `
                <img src="${book.coverSmallUrl || book.coverUrl}" alt="${book.title}" class="w-full h-full object-cover" />
              ` : `
                <div class="w-full h-full flex items-center justify-center text-slate-500 text-xs">Buku</div>
              `}
            </a>

            <div class="flex-1 min-w-0">
              <a href="${targetHref}">
                <h3 class="text-sm font-semibold text-slate-100 line-clamp-2">${book.title}</h3>
              </a>
              <p class="text-xs text-slate-400 truncate mt-0.5">${book.author}</p>

              ${progress > 0 ? `
                <div class="mt-2">
                  <div class="flex items-center justify-between text-[10px] text-amber-400 mb-1">
                    <span>Membaca</span>
                    <span>${progress}%</span>
                  </div>
                  <div class="w-full bg-slate-800 rounded-full h-1.5">
                    <div class="bg-amber-500 h-1.5 rounded-full" style="width: ${progress}%"></div>
                  </div>
                </div>
              ` : `
                <span class="inline-block mt-2 text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-400">Tersimpan</span>
              `}
            </div>

            <div class="flex flex-col items-end gap-2 flex-shrink-0">
              <button
                type="button"
                data-id="${book.id}"
                class="remove-btn p-2 text-slate-500 hover:text-rose-400"
                title="Hapus dari Koleksi"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              </button>

              ${isGutenberg ? `
                <a href="/read/${gutenId}" class="text-xs px-3 py-1 bg-amber-500 text-slate-950 font-medium rounded-lg">
                  ${progress > 0 ? 'Lanjut' : 'Baca'}
                </a>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');

      // Attach remove handlers
      document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (id) {
            removeBook(id);
            renderLibrary();
          }
        });
      });
    }

    document.getElementById('filter-all')?.addEventListener('click', (e) => {
      currentFilter = 'all';
      updateFilterTabs(e.target as HTMLElement);
      renderLibrary();
    });

    document.getElementById('filter-reading')?.addEventListener('click', (e) => {
      currentFilter = 'reading';
      updateFilterTabs(e.target as HTMLElement);
      renderLibrary();
    });

    function updateFilterTabs(activeEl: HTMLElement) {
      document.querySelectorAll('#filter-all, #filter-reading').forEach(btn => {
        btn.className = 'px-3 py-1.5 rounded-full bg-slate-900 text-slate-400 hover:text-slate-200 touch-target min-h-[36px]';
      });
      activeEl.className = 'px-3 py-1.5 rounded-full bg-amber-500 text-slate-950 font-semibold touch-target min-h-[36px]';
    }

    renderLibrary();
  </script>
</MobileLayout>
