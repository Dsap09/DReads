---
import MobileLayout from '../../layouts/MobileLayout.astro';

const { id } = Astro.params;
const decodedId = decodeURIComponent(id || '');

let bookTitle = 'Detail Buku';
let bookAuthor = 'Penulis Tidak Diketahui';
let bookCover = '';
let publishYear = '-';
let sourceName = 'External API';
let embeddedReaderUrl = '';

if (decodedId.startsWith('ol:')) {
  const key = decodedId.replace('ol:', '');
  sourceName = 'Open Library Reader';
  try {
    // Query search API to get Internet Archive ID (ia) if available
    const res = await fetch(`https://openlibrary.org/search.json?q=key:${key}&fields=key,title,author_name,cover_i,first_publish_year,ia&limit=1`);
    if (res.ok) {
      const data = await res.json();
      const doc = (data.docs || [])[0];
      if (doc) {
        bookTitle = doc.title || 'Buku OpenLibrary';
        bookAuthor = Array.isArray(doc.author_name) ? doc.author_name.join(', ') : (doc.author_name || 'Penulis');
        publishYear = doc.first_publish_year || '-';
        if (doc.cover_i) {
          bookCover = `https://covers.openlibrary.org/b/id/${doc.cover_i}-L.jpg`;
        }
        const iaId = Array.isArray(doc.ia) && doc.ia.length > 0 ? doc.ia[0] : null;
        if (iaId) {
          embeddedReaderUrl = `https://archive.org/embed/${iaId}?ui=full`;
        } else {
          embeddedReaderUrl = `https://openlibrary.org/works/${key}?mode=embed`;
        }
      }
    }
  } catch (e) {
    console.warn('Error fetching OpenLibrary book:', e);
  }

  // Fallback if search didn't yield work
  if (!embeddedReaderUrl) {
    embeddedReaderUrl = `https://openlibrary.org/works/${key}?mode=embed`;
  }
} else if (decodedId.startsWith('gb:')) {
  const gbId = decodedId.replace('gb:', '');
  sourceName = 'Google Books Reader';
  embeddedReaderUrl = `https://books.google.com/books?id=${gbId}&lpg=PP1&pg=PP1&output=embed`;

  try {
    const res = await fetch(`https://www.googleapis.com/books/v1/volumes/${gbId}`);
    if (res.ok) {
      const data = await res.json();
      const info = data.volumeInfo || {};
      bookTitle = info.title || 'Buku Google Books';
      bookAuthor = (info.authors || []).join(', ') || 'Penulis';
      publishYear = info.publishedDate ? info.publishedDate.substring(0, 4) : '-';
      if (info.imageLinks) {
        bookCover = (info.imageLinks.thumbnail || info.imageLinks.smallThumbnail || '').replace('http:', 'https:');
      }
    }
  } catch (e) {
    console.warn('Error fetching Google Books details:', e);
  }
}
---

<MobileLayout title={`${bookTitle} - Reader DReads`} activeTab="search">
  <!-- Top Navigation Bar -->
  <div class="sticky top-0 z-30 bg-slate-950/90 backdrop-blur-md border-b border-slate-800 px-4 py-3 flex items-center justify-between">
    <a href="/search" class="text-xs text-slate-300 hover:text-amber-400 flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      <span>Kembali</span>
    </a>
    <span class="text-xs font-semibold text-slate-400">{sourceName}</span>
  </div>

  <div class="px-4 py-4 space-y-4">
    <!-- Compact Book Info -->
    <div class="flex items-center gap-3 p-3 bg-slate-900/80 border border-slate-800 rounded-2xl">
      <div class="w-14 h-20 rounded-xl overflow-hidden bg-slate-800 flex-shrink-0 border border-slate-700/50">
        {bookCover ? (
          <img src={bookCover} alt={bookTitle} class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-slate-600 text-[10px]">Sampul</div>
        )}
      </div>

      <div class="flex-1 min-w-0">
        <h1 class="text-sm font-bold text-slate-100 line-clamp-1">{bookTitle}</h1>
        <p class="text-xs text-slate-400 truncate mt-0.5">{bookAuthor}</p>
        <span class="inline-block text-[10px] px-2 py-0.5 bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded-full mt-1.5">
          Mode Baca Dalam Web
        </span>
      </div>

      <button
        id="detail-bookmark-btn"
        class="p-2 text-slate-400 hover:text-amber-400 rounded-xl bg-slate-800 border border-slate-700/60"
        aria-label="Simpan Buku"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
        </svg>
      </button>
    </div>

    <!-- In-App Embedded Web Reader Container -->
    <div class="space-y-2">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Pembaca Buku Dalam Web</h2>
        <button
          id="fullscreen-toggle-btn"
          type="button"
          class="text-xs text-amber-500 hover:text-amber-400 font-medium flex items-center gap-1"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
          </svg>
          <span>Layar Penuh</span>
        </button>
      </div>

      <!-- Iframe Reader Wrapper -->
      <div id="reader-iframe-wrapper" class="relative w-full h-[70vh] rounded-2xl overflow-hidden bg-slate-900 border border-slate-800 shadow-2xl transition-all duration-300">
        <iframe
          src={embeddedReaderUrl}
          title={`Reader ${bookTitle}`}
          class="w-full h-full border-0 rounded-2xl"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </div>

  <script>
    import { isBookSaved, saveBook, removeBook } from '../../lib/storage';

    const pathParts = window.location.pathname.split('/');
    const bookId = decodeURIComponent(pathParts[pathParts.length - 1] || '');
    const bookmarkBtn = document.getElementById('detail-bookmark-btn');
    const fullscreenBtn = document.getElementById('fullscreen-toggle-btn');
    const iframeWrapper = document.getElementById('reader-iframe-wrapper');

    let isFullscreen = false;

    if (fullscreenBtn && iframeWrapper) {
      fullscreenBtn.addEventListener('click', () => {
        isFullscreen = !isFullscreen;
        if (isFullscreen) {
          iframeWrapper.classList.remove('h-[70vh]');
          iframeWrapper.classList.add('fixed', 'inset-0', 'z-50', 'rounded-none', 'h-screen', 'w-screen');
          fullscreenBtn.innerHTML = `
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <span>Tutup Layar Penuh</span>
          `;
        } else {
          iframeWrapper.classList.remove('fixed', 'inset-0', 'z-50', 'rounded-none', 'h-screen', 'w-screen');
          iframeWrapper.classList.add('h-[70vh]');
          fullscreenBtn.innerHTML = `
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
            </svg>
            <span>Layar Penuh</span>
          `;
        }
      });
    }

    function updateBtnState() {
      if (!bookmarkBtn) return;
      const svg = bookmarkBtn.querySelector('svg');
      if (isBookSaved(bookId)) {
        svg?.classList.add('text-amber-500', 'fill-amber-500');
      } else {
        svg?.classList.remove('text-amber-500', 'fill-amber-500');
      }
    }

    bookmarkBtn?.addEventListener('click', () => {
      const title = document.querySelector('h1')?.textContent || 'Buku';
      const author = document.querySelector('p')?.textContent || 'Penulis';
      const img = document.querySelector('img') as HTMLImageElement;

      if (isBookSaved(bookId)) {
        removeBook(bookId);
      } else {
        saveBook({
          id: bookId,
          title,
          author,
          coverUrl: img?.src || '',
          coverSmallUrl: img?.src || '',
          source: bookId.startsWith('ol:') ? 'openlibrary' : 'googlebooks'
        });
      }
      updateBtnState();
    });

    updateBtnState();
  </script>
</MobileLayout>
