---
import MobileLayout from '../layouts/MobileLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import BookListItem from '../components/BookListItem.astro';
import type { Book } from '../lib/api';

// Curated 100% Free full-text books for Homepage
let featuredBooks: Book[] = [
  {
    id: 'gutenberg:1342',
    title: 'Pride and Prejudice',
    author: 'Jane Austen',
    coverUrl: 'https://www.gutenberg.org/cache/epub/1342/pg1342.cover.medium.jpg',
    coverSmallUrl: 'https://www.gutenberg.org/cache/epub/1342/pg1342.cover.medium.jpg',
    firstPublishYear: '1813',
    source: 'gutendex'
  },
  {
    id: 'gutenberg:1661',
    title: 'The Adventures of Sherlock Holmes',
    author: 'Arthur Conan Doyle',
    coverUrl: 'https://www.gutenberg.org/cache/epub/1661/pg1661.cover.medium.jpg',
    coverSmallUrl: 'https://www.gutenberg.org/cache/epub/1661/pg1661.cover.medium.jpg',
    firstPublishYear: '1892',
    source: 'gutendex'
  },
  {
    id: 'gutenberg:84',
    title: 'Frankenstein; Or, The Modern Prometheus',
    author: 'Mary Wollstonecraft Shelley',
    coverUrl: 'https://www.gutenberg.org/cache/epub/84/pg84.cover.medium.jpg',
    coverSmallUrl: 'https://www.gutenberg.org/cache/epub/84/pg84.cover.medium.jpg',
    firstPublishYear: '1818',
    source: 'gutendex'
  },
  {
    id: 'gutenberg:11',
    title: "Alice's Adventures in Wonderland",
    author: 'Lewis Carroll',
    coverUrl: 'https://www.gutenberg.org/cache/epub/11/pg11.cover.medium.jpg',
    coverSmallUrl: 'https://www.gutenberg.org/cache/epub/11/pg11.cover.medium.jpg',
    firstPublishYear: '1865',
    source: 'gutendex'
  },
  {
    id: 'gutenberg:2701',
    title: 'Moby Dick; Or, The Whale',
    author: 'Herman Melville',
    coverUrl: 'https://www.gutenberg.org/cache/epub/2701/pg2701.cover.medium.jpg',
    coverSmallUrl: 'https://www.gutenberg.org/cache/epub/2701/pg2701.cover.medium.jpg',
    firstPublishYear: '1851',
    source: 'gutendex'
  }
];
---

<MobileLayout title="DReads - Baca Buku Digital Gratis" activeTab="home">
  <!-- Top Hero Header -->
  <div class="px-4 pt-5 pb-3 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 border-b border-slate-800/50">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-500">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
        <div>
          <h1 class="text-base font-bold text-slate-100 leading-tight">DReads</h1>
          <p class="text-[11px] text-slate-400">Pembaca E-Book Digital Gratis</p>
        </div>
      </div>
      <a href="/library" class="text-xs px-2.5 py-1 rounded-full bg-slate-800 text-amber-400 border border-slate-700/80 font-medium">
        Koleksi Saya
      </a>
    </div>

    <!-- Quick Search Header -->
    <SearchBar />
  </div>

  <!-- Content Container -->
  <div class="px-4 py-4 space-y-6">
    <!-- Continue Reading Banner (client-hydrated from localStorage) -->
    <div id="continue-reading-container" class="hidden">
      <h2 class="text-xs font-bold uppercase tracking-wider text-amber-500 mb-2 flex items-center gap-1.5">
        <svg class="w-4 h-4 animate-spin-slow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Lanjutkan Membaca
      </h2>
      <div id="continue-reading-card" class="bg-gradient-to-r from-amber-500/10 via-slate-900 to-slate-900 border border-amber-500/30 rounded-2xl p-4 flex items-center justify-between gap-3 shadow-lg">
        <div class="min-w-0">
          <h3 id="continue-title" class="text-sm font-semibold text-slate-100 truncate"></h3>
          <p id="continue-author" class="text-xs text-slate-400 truncate mt-0.5"></p>
          <div class="w-full bg-slate-800 rounded-full h-1.5 mt-2 max-w-[160px]">
            <div id="continue-progress-bar" class="bg-amber-500 h-1.5 rounded-full" style="width: 0%"></div>
          </div>
        </div>
        <a id="continue-link" href="#" class="px-3.5 py-1.5 bg-amber-500 text-slate-950 font-semibold text-xs rounded-xl hover:bg-amber-400 transition-colors shadow">
          Lanjut
        </a>
      </div>
    </div>

    <!-- Quick Category Chips -->
    <div>
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">Jelajahi Kategori E-Book</h2>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <a href="/search?category=Fiction&source=gutendex" class="p-3 bg-slate-900/80 hover:bg-slate-800 border border-slate-800/80 rounded-xl flex items-center gap-2 text-slate-200 transition-colors">
          <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          <span class="font-medium">Klasik Dunia (Gutendex)</span>
        </a>
        <a href="/search?category=Mystery&source=gutendex" class="p-3 bg-slate-900/80 hover:bg-slate-800 border border-slate-800/80 rounded-xl flex items-center gap-2 text-slate-200 transition-colors">
          <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span class="font-medium">Misteri & Detektif</span>
        </a>
        <a href="/search?category=Indonesia&source=openlibrary" class="p-3 bg-slate-900/80 hover:bg-slate-800 border border-slate-800/80 rounded-xl flex items-center gap-2 text-slate-200 transition-colors">
          <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>
          </svg>
          <span class="font-medium">Buku Indonesia (Open Library)</span>
        </a>
        <a href="/search?category=Adventure&source=gutendex" class="p-3 bg-slate-900/80 hover:bg-slate-800 border border-slate-800/80 rounded-xl flex items-center gap-2 text-slate-200 transition-colors">
          <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span class="font-medium">Petualangan</span>
        </a>
      </div>
    </div>

    <!-- Featured Public Domain Books -->
    <div>
      <div class="flex items-center justify-between mb-3">
        <div>
          <h2 class="text-sm font-bold text-slate-100">Buku Pilihan Gratis</h2>
          <p class="text-xs text-slate-400">100% Teks Penuh Tanpa Bayar</p>
        </div>
        <a href="/search?source=gutendex" class="text-xs text-amber-500 hover:underline">Lihat Semua</a>
      </div>

      <div class="space-y-3">
        {featuredBooks.map((book) => (
          <BookListItem book={book} />
        ))}
      </div>
    </div>
  </div>

  <!-- Hydrate Continue Reading Card -->
  <script>
    import { getSavedBooks } from '../lib/storage';

    const savedBooks = getSavedBooks();
    const lastReadBook = savedBooks.find(b => (b.lastReadProgress || 0) > 0);

    if (lastReadBook) {
      const container = document.getElementById('continue-reading-container');
      const titleEl = document.getElementById('continue-title');
      const authorEl = document.getElementById('continue-author');
      const progressEl = document.getElementById('continue-progress-bar');
      const linkEl = document.getElementById('continue-link') as HTMLAnchorElement;

      if (container && titleEl && authorEl && progressEl && linkEl) {
        const targetUrl = lastReadBook.id.startsWith('gutenberg:') ? `/read/${lastReadBook.id.replace('gutenberg:', '')}` : `/book/${encodeURIComponent(lastReadBook.id)}`;
        titleEl.textContent = lastReadBook.title;
        authorEl.textContent = lastReadBook.author;
        progressEl.style.width = `${lastReadBook.lastReadProgress || 0}%`;
        linkEl.href = targetUrl;
        container.classList.remove('hidden');
      }
    }

    // Attach bookmark handlers
    document.querySelectorAll('.bookmark-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const bookData = JSON.parse(btn.getAttribute('data-book') || '{}');
        import('../lib/storage').then(({ isBookSaved, saveBook, removeBook }) => {
          const svg = btn.querySelector('svg');
          if (isBookSaved(bookData.id)) {
            removeBook(bookData.id);
            if (svg) svg.classList.remove('text-amber-500', 'fill-amber-500');
          } else {
            saveBook(bookData);
            if (svg) svg.classList.add('text-amber-500', 'fill-amber-500');
          }
        });
      });
    });
  </script>
</MobileLayout>
